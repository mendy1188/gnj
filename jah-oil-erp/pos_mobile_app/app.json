{
  "expo": {
    "name": "Jah POS Mobile App",
    "slug": "jah-pos-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jahposmobile",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jahoil.posmobile"
    },
    "android": {
      "package": "com.jahoil.posmobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ]
  }
}
