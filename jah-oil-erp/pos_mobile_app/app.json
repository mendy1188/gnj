{
  "expo": {
    "name": "Jah POS",
    "slug": "jah-pos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./images/jah-pos.png",
    "scheme": "jahposmobile",
    "userInterfaceStyle": "dark",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jahoil.posmobile"
    },
    "android": {
      "package": "com.jahoil.posmobile",
      "adaptiveIcon": {
        "foregroundImage": "./images/jah-pos.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "c02b3101-5941-4bb8-a50a-74a91451c895"
      }
    },
    "owner": "abmari"
  }
}
